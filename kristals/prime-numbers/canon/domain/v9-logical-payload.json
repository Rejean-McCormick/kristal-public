{
  "formal_core": {
    "subject": "Mécanique de la primalité",
    "invariant": {
      "id": "KQ1101",
      "formula": "Prime(n) ⇔ n>1 ∧ ¬∃a,b∈ℕ (a>1 ∧ b>1 ∧ n=ab)",
      "reading": "n est premier exactement quand la multiplication non triviale ne peut pas le produire."
    },
    "equivalent_morphs": [
      {
        "id": "KQ1104",
        "formula": "Div⁺(n)={1,n}",
        "domain_guard": "n ∈ ℕ, n ≥ 2"
      },
      {
        "id": "KQ1105",
        "formula": "∀p premier≤√n, p∤n",
        "domain_guard": "n ∈ ℕ, n ≥ 2"
      },
      {
        "id": "KQ1106",
        "formula": "φ(n)=n−1",
        "domain_guard": "n ∈ ℕ, n ≥ 2"
      },
      {
        "id": "KQ1107",
        "formula": "ℤ/nℤ est un corps",
        "domain_guard": "n ∈ ℕ, n ≥ 2"
      },
      {
        "id": "KQ1108",
        "formula": "ab≡0 mod n ⇒ a≡0 ou b≡0 mod n",
        "domain_guard": "n ∈ ℕ, n ≥ 2"
      },
      {
        "id": "KQ1109",
        "formula": "(n−1)!≡−1 mod n",
        "domain_guard": "n ∈ ℕ, n ≥ 2"
      },
      {
        "id": "KQ1111",
        "formula": "𝔓=ℕ_{≥2}\\{ab:a,b>1}",
        "domain_guard": "n ∈ ℕ, n ≥ 2"
      }
    ],
    "derived_not_equivalent": [
      {
        "id": "KQ1110",
        "formula": "Prime(n) ⇒ ∀a, a^n≡a mod n",
        "guard": "Converse false in general; e.g. 561."
      }
    ],
    "evidence_asymmetry": {
      "composite": "One nontrivial factor d is a positive witness.",
      "prime": "Requires exclusion of all possible nontrivial factors, made finite by p≤√n or replaced by a verifiable certificate."
    },
    "dynamic_view": "Mark all nontrivial multiples generated by established primes; an uncovered integer is prime and becomes a new generator.",
    "equivalence_domain": "n ∈ ℕ, n ≥ 2"
  },
  "subjects": [
    {
      "subject_id": "KQ1001",
      "label": "Mécanique de la primalité"
    }
  ],
  "policies": {
    "logical_typing": "Equivalent characterizations, implications, procedures and witnesses MUST remain distinct.",
    "projection_axes": {
      "primary": "KQ2001",
      "secondary": "KQ2002"
    },
    "scope_exclusion": "Prime distribution/statistical occurrence is outside the core subject unless explicitly projected as another orientation."
