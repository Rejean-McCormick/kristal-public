      "entities": [
        {
          "entity_id": "KQ1001",
          "entity_kind": "subject",
          "preferred_label": "Mécanique de la primalité",
          "status": "stable",
          "source_referents": [],
          "definition": "Étude de ce qui fait qu'un entier n>1 est premier, indépendamment de la distribution statistique des nombres premiers."
        },
        {
          "entity_id": "KQ1101",
          "entity_kind": "mathematical_predicate",
          "preferred_label": "Prime(n)",
          "status": "stable",
          "source_referents": [],
          "formal": "n>1 ∧ ¬∃a,b∈ℕ: a>1 ∧ b>1 ∧ n=ab"
        },
        {
          "entity_id": "KQ1102",
          "entity_kind": "mathematical_predicate",
          "preferred_label": "Composite(n)",
          "status": "stable",
          "source_referents": [],
          "formal": "n>1 ∧ ∃a,b∈ℕ: a>1 ∧ b>1 ∧ n=ab"
        },
        {
          "entity_id": "KQ1103",
          "entity_kind": "characterization",
          "preferred_label": "Irréductibilité multiplicative",
          "status": "stable",
          "source_referents": [],
          "formal": "Pour n∈ℕ, n≥2 : Toute factorisation n=ab dans ℕ force a=1 ou b=1.",
          "domain_guard": "n ∈ ℕ, n ≥ 2"
        },
        {
          "entity_id": "KQ1104",
          "entity_kind": "characterization",
          "preferred_label": "Ensemble de diviseurs trivial",
          "status": "stable",
          "source_referents": [],
          "formal": "Pour n∈ℕ, n≥2 : Div⁺(n)={1,n}",
          "domain_guard": "n ∈ ℕ, n ≥ 2"
        },
        {
          "entity_id": "KQ1105",
          "entity_kind": "characterization",
          "preferred_label": "Aucun diviseur premier jusqu'à √n",
          "status": "stable",
          "source_referents": [],
          "formal": "Pour n∈ℕ, n≥2 : ∀p premier, p≤√n ⇒ p∤n",
          "domain_guard": "n ∈ ℕ, n ≥ 2"
        },
        {
          "entity_id": "KQ1106",
          "entity_kind": "characterization",
          "preferred_label": "Totient maximal",
          "status": "stable",
          "source_referents": [],
          "formal": "Pour n∈ℕ, n≥2 : φ(n)=n−1",
          "domain_guard": "n ∈ ℕ, n ≥ 2"
        },
        {
          "entity_id": "KQ1107",
          "entity_kind": "characterization",
          "preferred_label": "Corps résiduel",
          "status": "stable",
          "source_referents": [],
          "formal": "Pour n∈ℕ, n≥2 : ℤ/nℤ est un corps",
          "domain_guard": "n ∈ ℕ, n ≥ 2"
        },
        {
          "entity_id": "KQ1108",
          "entity_kind": "characterization",
          "preferred_label": "Absence de diviseurs de zéro",
          "status": "stable",
          "source_referents": [],
          "formal": "Pour n∈ℕ, n≥2 : ab≡0 (mod n) ⇒ a≡0 (mod n) ou b≡0 (mod n)",
          "domain_guard": "n ∈ ℕ, n ≥ 2"
        },
        {
          "entity_id": "KQ1109",
          "entity_kind": "characterization",
          "preferred_label": "Critère de Wilson",
          "status": "stable",
          "source_referents": [],
          "formal": "Pour n∈ℕ, n≥2 : (n−1)!≡−1 (mod n)",
          "domain_guard": "n ∈ ℕ, n ≥ 2"
        },
        {
          "entity_id": "KQ1110",
          "entity_kind": "consequence",
          "preferred_label": "Signature de Fermat",
          "status": "stable",
          "source_referents": [],
          "formal": "Prime(n) ⇒ ∀a∈ℤ, a^n≡a (mod n)",
          "logical_note": "Nécessaire mais non suffisante en général; les nombres de Carmichael fournissent des contre-exemples au converse."
        },
        {
          "entity_id": "KQ1111",
          "entity_kind": "set_characterization",
          "preferred_label": "Image multiplicative non triviale",
          "status": "stable",
          "source_referents": [],
          "formal": "C={ab | a,b∈ℕ, a>1, b>1}; 𝔓=ℕ_{≥2}\\C"
        },
        {
          "entity_id": "KQ1112",
          "entity_kind": "mechanism",
          "preferred_label": "Dynamique survivant-générateur",
          "status": "stable",
          "source_referents": [],
          "definition": "Les composés sont couverts par les multiples des premiers déjà établis; un entier non couvert devient un nouveau générateur premier."
        },
        {
          "entity_id": "KQ1201",
          "entity_kind": "procedure",
          "preferred_label": "Division d'essai bornée",
          "status": "stable",
          "source_referents": [],
          "formal": "Tester les p premiers tels que p≤√n."
        },
        {
          "entity_id": "KQ1202",
          "entity_kind": "procedure",
          "preferred_label": "Crible d'Ératosthène",
          "status": "stable",
          "source_referents": [],
          "definition": "Marquer les multiples non triviaux des premiers; les survivants sont premiers."
        },
        {
          "entity_id": "KQ1203",
          "entity_kind": "procedure",
          "preferred_label": "Miller–Rabin",
          "status": "stable",
          "source_referents": [],
          "definition": "Test rapide fournissant des témoins de compositeness; probabiliste en général, déterministe sous des bornes avec bases appropriées."
        },
